<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>Roll.MusicTrack</Name>
      <ViewSelectedBy>
        <TypeName>Roll.MusicTrack</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <AutoSize />
        <TableHeaders>
          <TableColumnHeader>
            <Label>Name</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Intensity</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Emotion</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Scene</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Game</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Type</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Situation</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Description</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Name</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Intensity</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Emotion</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Scene</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Game</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  @(
                    $_.Type
                    if ($_.IsIntro) { 'Intro' }
                    if ($_.IsOutro) { 'Outro' }
                    if ($_.IsUnsorted) { 'Unsorted' }
                  ) -join ','
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Situation</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Description</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>

