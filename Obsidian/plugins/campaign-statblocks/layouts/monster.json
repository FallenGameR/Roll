  "id": "monster-layout",
  "name": "Монстр",
  "edited": false,
  "diceParsing": [
    {
      "regex": "([\\+\\-])(\\d+) to hit",
      "parser": "let [, sign, number] = matches;\nlet mult = sign === \"-\" ? -1 : 1;\nif (isNaN(Number(number))) return original;\nreturn [original + \"\\u00a0\\u00a0\\u00a0[\", { text: `1d20+${mult * Number(number)}|none` }, \"]\"];",
      "id": "d51bu2j1497",
      "desc": "+10 to hit"
    },
    {
      "regex": "(\\d+)\\s\\((\\d+d\\d+(?:\\s*[+\\-]\\s*\\d+)?)\\)",
      "parser": "let [, base, dice] = matches;\nif (isNaN(Number(base)) || !dice) return original;\nreturn [dice + \"\\u00a0\\u00a0\\u00a0[\", { text: dice + \"|none\" }, \"]\"];",
      "id": "gftkvjz8acb",
      "desc": "4 (1d6 + 1)"
    },
    {
      "regex": "([^\\s]+) ([\\+\\-])(\\d+)",
      "parser": "let [, save, sign, number] = matches;\nlet mult = sign === \"-\" ? -1 : 1;\nif (isNaN(Number(number))) return original;\nreturn [`${save} ${sign}${number}\\u00a0\\u00a0\\u00a0[`, { text: `1d20+${mult * Number(number)}|none` }, \"]\"];",
      "id": "51oambwykpc",
      "desc": "+5"
    },
    {
      "regex": "(?<![\\w>(`])`?(\\d+d\\d+(?:\\s*[+\\-]\\s*\\d+)?)`?(?![\\w)`])",
      "parser": "let [, dice] = matches;\nif (!dice) return original;\nreturn [dice + \"\\u00a0\\u00a0\\u00a0[\", { text: dice.replace(/\\s+/g, \"\") + \"|none\" }, \"]\"];",
      "id": "barediceru01",
      "desc": "3d8"
    }
  ]
}
