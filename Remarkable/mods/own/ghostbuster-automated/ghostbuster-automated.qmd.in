; ghostbuster-automated.qmd - full screen refresh on its own, at the moments
; where ghosting is left behind. Each event restarts a short timer, so the
; refresh happens once, after the screen has finished drawing. Every trigger
; writes "gba: <event>" to the xochitl journal, to see which one fired.
; Events:
;   settings opened                    (Settings.qml, onOpened)
;   loading indicator went away after it was drawn (Loading.qml, hide)
;   PIN accepted                       (MainView.qml, passcodeHandler.userLocked)
;   library got input focus back for the first time after waking up or after
;   xochitl start, that is after the PIN screen (Navigator.qml: BatteryManager,
;   activeFocus)
;   page turn that took long to draw   (DocumentView.qml: currentPage, isLoading);
;   toolbar panel closed               (ToolbarFoldout.qml, visible)
;   toolbar hidden or collapsed        (DocumentView.qml: toolbar.shown, expanded)
;                                       heavy pages (graphics-rich PDFs) leave
;                                       ghosting, quick ones are left alone
; Source: ghostbuster-automated.qmd.in, encoded by Tools\Remarkable\encode-qmd.py.
; SPDX-License-Identifier: GPL-3.0-only. Built for firmware 3.29.1.

; Document: a page turn that took long to draw. The time from the page change
; to the end of loading (tiles rendered) is measured; above gbaSlowTurnMs the
; screen is refreshed. Every turn writes its time to the journal, to tune the
; threshold.
AFFECT [[/qml/device/view/documentview/DocumentView.qml]]
    IMPORT [[com.remarkable]] 1.0
    TRAVERSE [[FocusScope]]#[[root]]
        LOCATE AFTER ALL
        INSERT {
            property ~&int&~ gbaSlowTurnMs: 400
            property ~&double&~ gbaTurnAt: 0

            ~&Binding&~ {
                ~&target&~: ~&loadingIndicator&~
                property: "gbaSelfRefresh"
                ~&value&~: ~&false&~
            }

            ~&Timer&~ {
                ~&id&~: gbaTurnTimer
                ~&interval&~: 700
                ~&repeat&~: ~&false&~
                ~&onTriggered&~: {
                    ~&EPFramebuffer&~.clearGhosting();
                }
            }

            ~&Connections&~ {
                ~&target&~: ~&root&~
                function ~&onCurrentPageChanged&~() {
                    ~&root&~.gbaTurnAt = ~&Date&~.now();
                }
                function onIsLoadingChanged() {
                    ~&if&~ (~&root&~.~&isLoading&~ || ~&root&~.gbaTurnAt <= 0) {
                        ~&return&~;
                    }
                    ~&const&~ took = ~&Date&~.now() - ~&root&~.gbaTurnAt;
                    ~&root&~.gbaTurnAt = 0;
                    ~&const&~ slow = took > ~&root&~.gbaSlowTurnMs;
                    ~&console&~.~&log&~("gba: page turn " + took + " ms" + (slow ? ", refresh" : ""));
                    ~&if&~ (slow) {
                        gbaTurnTimer.~&restart&~();
                    }
                }
            }
        }
    END TRAVERSE
END AFFECT

; Settings opened
AFFECT [[/qml/device/view/settings/Settings.qml]]
    IMPORT [[com.remarkable]] 1.0
    TRAVERSE [[Item]]#[[root]]
        LOCATE AFTER ALL
        INSERT {
            ~&Timer&~ {
                ~&id&~: gbaSettingsTimer
                ~&interval&~: 400
                ~&repeat&~: ~&false&~
                ~&onTriggered&~: {
                    ~&console&~.~&log&~("gba: settings opened");
                    ~&EPFramebuffer&~.clearGhosting();
                }
            }
        }

        REBUILD [[onOpened]]
            LOCATE AFTER STREAM \~&ghostBuster&~.~&viewChange&~(~&GhostBuster&~.~&SettingsOpened&~);\ INSERT STREAM \ gbaSettingsTimer.~&restart&~();\
        END REBUILD
    END TRAVERSE
END AFFECT

; gbaSelfRefresh: the document view turns it off for its own indicator and
; refreshes once together with the page turn.
; Loading indicator (the dots in the middle of the screen) went away after it
; was actually drawn. Patched in the indicator itself, so it covers every place
; that shows one. The indicator draws only after a delay, so a quick open with
; no dots on screen gets no refresh.
AFFECT [[/qml/device/ui/controls/Loading.qml]]
    IMPORT [[com.remarkable]] 1.0
    TRAVERSE [[Item]]#[[root]]
        LOCATE AFTER ALL
        INSERT {
            property ~&bool&~ gbaDrawn: ~&false&~
            property ~&bool&~ gbaSelfRefresh: ~&true&~

            ~&Timer&~ {
                ~&id&~: gbaSpinnerTimer
                ~&interval&~: 1000
                ~&repeat&~: ~&false&~
                ~&onTriggered&~: {
                    ~&console&~.~&log&~("gba: loading indicator gone");
                    ~&EPFramebuffer&~.clearGhosting();
                }
            }
        }

        ; visualRoot.visible can not tell: by the time hide() runs the whole
        ; indicator is already invisible, and QML reports the child invisible too.
        ; So show() sets a flag of our own.
        REBUILD [[show]]
            LOCATE AFTER STREAM \~&tickTimer&~.~&start&~();\ INSERT STREAM \ ~&root&~.gbaDrawn = ~&true&~;\
        END REBUILD

        REBUILD [[hide]]
            LOCATE BEFORE STREAM \~&delayedShowTimer&~.~&stop&~();\ INSERT STREAM \ ~&if&~ (~&root&~.gbaDrawn) { ~&root&~.gbaDrawn = ~&false&~; ~&if&~ (~&root&~.gbaSelfRefresh) gbaSpinnerTimer.~&restart&~(); }\
        END REBUILD
    END TRAVERSE
END AFFECT

; Toolbar panel (pens, colours, tags, layers...) closed. Patched in the panel
; itself, so every toolbar panel is covered. Nested panels closing together
; restart the same timer and give one refresh.
AFFECT [[/qt/qml/xofm/libs/toolbar/qml/ToolbarFoldout.qml]]
    IMPORT [[com.remarkable]] 1.0
    TRAVERSE [[Control]]#[[root]]
        LOCATE AFTER ALL
        INSERT {
            ~&Timer&~ {
                ~&id&~: gbaFoldoutTimer
                ~&interval&~: 400
                ~&repeat&~: ~&false&~
                ~&onTriggered&~: {
                    ~&console&~.~&log&~("gba: toolbar panel closed");
                    ~&EPFramebuffer&~.clearGhosting();
                }
            }

            ~&Connections&~ {
                ~&target&~: ~&root&~
                function ~&onVisibleChanged&~() {
                    ~&if&~ (!~&root&~.~&visible&~) {
                        gbaFoldoutTimer.~&restart&~();
                    }
                }
            }
        }
    END TRAVERSE
END AFFECT

; Document: the toolbar itself was hidden or collapsed.
AFFECT [[/qml/device/view/documentview/DocumentView.qml]]
    IMPORT [[com.remarkable]] 1.0
    TRAVERSE [[FocusScope]]#[[root]]
        LOCATE AFTER ALL
        INSERT {
            ~&Timer&~ {
                ~&id&~: gbaToolbarTimer
                ~&interval&~: 400
                ~&repeat&~: ~&false&~
                ~&onTriggered&~: {
                    ~&console&~.~&log&~("gba: toolbar hidden");
                    ~&EPFramebuffer&~.clearGhosting();
                }
            }

            ~&Connections&~ {
                ~&target&~: ~&toolbar&~
                function onShownChanged() {
                    ~&if&~ (!~&toolbar&~.~&shown&~) {
                        gbaToolbarTimer.~&restart&~();
                    }
                }
                function ~&onExpandedChanged&~() {
                    ~&if&~ (!~&toolbar&~.~&expanded&~) {
                        gbaToolbarTimer.~&restart&~();
                    }
                }
            }
        }
    END TRAVERSE
END AFFECT

; PIN accepted: the unlock screen goes away. MainView lives all the time, so
; the timer survives the unlock window closing.
AFFECT [[/qml/device/view/main/MainView.qml]]
    IMPORT [[com.remarkable]] 1.0
    TRAVERSE [[Background]]#[[root]]
        LOCATE AFTER ALL
        INSERT {
            ~&Timer&~ {
                ~&id&~: gbaUnlockTimer
                ~&interval&~: 300
                ~&repeat&~: ~&false&~
                ~&onTriggered&~: {
                    ~&console&~.~&log&~("gba: unlocked");
                    ~&EPFramebuffer&~.clearGhosting();
                }
            }

            ~&Connections&~ {
                ~&target&~: ~&root&~.~&passcodeHandler&~
                function onUserLockedChanged() {
                    ~&if&~ (!~&root&~.~&passcodeHandler&~.~&userLocked&~) {
                        gbaUnlockTimer.~&restart&~();
                    }
                }
            }
        }
    END TRAVERSE
END AFFECT

; Library: first input focus after waking up (or after xochitl start), i.e.
; after the PIN screen closed. Other returns to the library are left alone.
AFFECT [[/qml/device/view/navigator/Navigator.qml]]
    IMPORT [[com.remarkable]] 1.0
    TRAVERSE [[FocusScope]]#[[root]]
        LOCATE AFTER ALL
        INSERT {
            property ~&bool&~ gbaAfterWake: ~&true&~

            ~&Timer&~ {
                ~&id&~: gbaLibraryTimer
                ~&interval&~: 400
                ~&repeat&~: ~&false&~
                ~&onTriggered&~: {
                    ~&if&~ (~&root&~.~&visible&~) {
                        ~&console&~.~&log&~("gba: library after wake");
                        ~&EPFramebuffer&~.clearGhosting();
                    }
                }
            }

            ~&Connections&~ {
                ~&target&~: ~&BatteryManager&~
                function ~&onDisplayStateChanged&~(previous, next) {
                    ~&if&~ (~&root&~.~&wasSleepingAndIsAwake&~(previous, next)) {
                        ~&root&~.gbaAfterWake = ~&true&~;
                    }
                }
            }

            ~&Connections&~ {
                ~&target&~: ~&root&~
                function ~&onActiveFocusChanged&~() {
                    ~&if&~ (~&root&~.~&activeFocus&~ && ~&root&~.gbaAfterWake) {
                        ~&root&~.gbaAfterWake = ~&false&~;
                        gbaLibraryTimer.~&restart&~();
                    }
                }
            }
        }
    END TRAVERSE
END AFFECT